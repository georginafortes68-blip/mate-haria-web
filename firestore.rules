rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Products collection
    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.token.email == 'georginafortes68@gmail.com' && request.auth.token.email_verified == true;
    }

    // Gallery collection
    match /gallery/{itemId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.token.email == 'georginafortes68@gmail.com' && request.auth.token.email_verified == true;
    }

    // Orders collection
    match /orders/{orderId} {
      // Allow customers to create orders
      allow create: if true; 
      // Allow customers to track their order if they have the ID
      allow get: if true;
      // Protected updates/list for admin
      allow list, update, delete: if isSignedIn() && request.auth.token.email == 'georginafortes68@gmail.com' && request.auth.token.email_verified == true;
    }
  }
}
